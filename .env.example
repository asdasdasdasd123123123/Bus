# Copy values into local `--dart-define` flags. Do not commit a filled .env.

# Free key from https://data.bus-data.dft.gov.uk/account/ (Account Settings)
BODS_API_KEY=

# Optional Transport for West Midlands developer portal credentials
# https://api-portal.tfwm.org.uk/
TFWM_APP_ID=
TFWM_APP_KEY=

# Force simulated vehicles/departures (UI works with no keys)
DEMO_MODE=false
